<!--
    ASPOS Print Agent — Windows Service descriptor for WinSW
    (https://github.com/winsw/winsw)

    Normal install: use the install.ps1 one-liner from the ASPOS dashboard —
    it clones the repo, writes .env, patches this file, and registers the service.

    Manual install (advanced):
        1. Run install.ps1 or clone the repo manually to a directory of your choice
        2. Edit .env in the install directory with BACKEND_URL, REVERB_APP_KEY,
           REVERB_HOST, AGENT_ID, and AGENT_TOKEN
        3. Download WinSW from https://github.com/winsw/winsw/releases and place
           AsposAgent.exe in the install directory alongside this file
        4. In an elevated command prompt from the install directory:
               AsposAgent.exe install
               AsposAgent.exe start
    Uninstall:
               AsposAgent.exe stop
               AsposAgent.exe uninstall

    Note: <env> entries and paths below are overwritten by install.ps1 at
    install time. The values here are placeholders only.
-->
<service>
    <id>AsposAgent</id>
    <name>ASPOS Print Agent</name>
    <description>Relays ESC/POS print jobs from ASPOS backend to local printers</description>

    <executable>node</executable>
    <arguments>src\index.js</arguments>
    <workingdirectory>C:\aspos-agent</workingdirectory>

    <startmode>Automatic</startmode>
    <delayedAutoStart>true</delayedAutoStart>

    <env name="BACKEND_URL"     value="https://your-tenant.aspos.io"/>
    <env name="REVERB_APP_KEY"  value="your_reverb_app_key"/>
    <env name="REVERB_HOST"     value="your-tenant.aspos.io"/>
    <env name="REVERB_PORT"     value="443"/>
    <env name="REVERB_SCHEME"   value="https"/>
    <env name="AGENT_ID"        value=""/>
    <env name="AGENT_TOKEN"     value="aspos_agt_replace_me"/>
    <env name="HEALTH_PORT"     value="8585"/>
    <env name="LOG_LEVEL"       value="info"/>

    <log mode="append">
        <logpath>C:\aspos-agent\logs</logpath>
    </log>

    <onfailure action="restart" delay="5 sec"/>
    <onfailure action="restart" delay="10 sec"/>
    <onfailure action="restart" delay="20 sec"/>
</service>
