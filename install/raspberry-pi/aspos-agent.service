[Unit]
Description=ASPOS Print Agent
Documentation=https://github.com/stszone/aspos-print-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aspos-agent
WorkingDirectory=/opt/aspos-agent
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5s
StandardOutput=append:/opt/aspos-agent/logs/agent.log
StandardError=append:/opt/aspos-agent/logs/agent.log
EnvironmentFile=/opt/aspos-agent/.env

# Ensure log directory exists before first start
ExecStartPre=/usr/bin/mkdir -p /opt/aspos-agent/logs

[Install]
WantedBy=multi-user.target
