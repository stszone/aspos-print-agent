# ASPOS Print Agent — copy to .env and fill in values

# Backend base URL (no trailing slash)
BACKEND_URL=https://your-tenant.aspos.io

# Reverb WebSocket connection
REVERB_APP_KEY=your_reverb_app_key
REVERB_HOST=your-tenant.aspos.io
REVERB_PORT=443
REVERB_SCHEME=https

# Agent credentials (issued by ASPOS when you register the agent)
AGENT_ID=
# Tenant slug, e.g. abushakra — the broadcast channel is tenant-scoped.
# The dashboard-generated install command fills this in (required since 1.1.0).
TENANT_ID=
AGENT_TOKEN=aspos_agt_<your_token>

# Health endpoint port (default 8585)
HEALTH_PORT=8585

# Trusted origin for CORS on /local-receipts and /reprint (default: derived from BACKEND_URL)
# ADMIN_UI_ORIGIN=https://your-tenant.aspos.io

# Log level: error | warn | info | debug
LOG_LEVEL=info
